{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDE CI Source v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "doc_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "established_by": {
      "type": "string",
      "minLength": 1
    },
    "document_version": {
      "type": "string",
      "minLength": 1
    },
    "document_status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "audience": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "workspace_pillar": {
      "enum": [
        "people",
        "products",
        "processes",
        "projects"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "subject_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "subject_id",
        "subject_version",
        "environment",
        "includes",
        "excludes"
      ],
      "additionalProperties": false
    },
    "last_reviewed": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_doc_update": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "in_sync",
            "needs_review",
            "conflict",
            "not_applicable"
          ]
        },
        "last_code_change": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "compared_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "last_code_change",
        "compared_at",
        "method",
        "scope_note",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "code",
              "document",
              "api",
              "runtime",
              "decision"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "revision",
          "content_sha256",
          "local_path",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_state": {
                  "enum": [
                    "observed",
                    "reported",
                    "planned",
                    "unknown"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "deprecated",
                    "removed"
                  ]
                },
                "replaced_by": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "uniqueItems": true
                },
                "qa": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "question": {
                        "type": "string",
                        "minLength": 1
                      },
                      "answer": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]*$"
                        },
                        "uniqueItems": true
                      },
                      "evidence_state": {
                        "enum": [
                          "observed",
                          "reported",
                          "planned",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "question",
                      "answer",
                      "source_ids",
                      "evidence_state"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "body",
                "evidence_state",
                "status",
                "replaced_by",
                "source_ids",
                "qa"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "sections"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "depends_on",
              "consumed_by",
              "shared_service"
            ]
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "compatible_versions": {
            "type": "string",
            "minLength": 1
          },
          "failure_impact": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "evidence_state": {
            "enum": [
              "observed",
              "reported",
              "planned",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "target",
          "direction",
          "contract",
          "compatible_versions",
          "failure_impact",
          "fallback",
          "owner",
          "source_ids",
          "evidence_state"
        ],
        "additionalProperties": false
      }
    },
    "miscellaneous_qa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "evidence_state": {
            "enum": [
              "observed",
              "reported",
              "planned",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "question",
          "answer",
          "source_ids",
          "evidence_state"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question",
          "owner",
          "next_action"
        ],
        "additionalProperties": false
      }
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "date",
          "version",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "doc_id",
    "title",
    "owner",
    "reviewer",
    "established_by",
    "document_version",
    "document_status",
    "audience",
    "workspace_pillar",
    "scope",
    "last_reviewed",
    "last_doc_update",
    "review_due",
    "freshness",
    "sources",
    "topics",
    "dependencies",
    "miscellaneous_qa",
    "gaps",
    "change_log",
    "extensions"
  ],
  "additionalProperties": false
}
